# Supabase — panel del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor (seed, carga de cohorte, invitaciones).
# Salta RLS: nunca la expongas al navegador ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envío de las invitaciones
RESEND_API_KEY=
CORREO_REMITENTE="Bitácora MEGA <hola@tu-dominio.co>"

# URL pública de la aplicación, para armar los enlaces de invitación
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# Base local de pruebas (scripts/db-local.sh)
DATABASE_URL_LOCAL=postgresql://postgres@/bitacora?host=/var/run/postgresql&port=5433
